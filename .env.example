# Copy this file to .env (or export these as real environment variables)
# and fill in your own values. .env is gitignored, never commit real secrets here.

GEMINI_API_KEY=your-gemini-api-key-from-aistudio.google.com

# At least 32 characters, e.g. generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars

DB_URL=jdbc:postgresql://localhost:5432/wikimind
DB_USERNAME=postgres
DB_PASSWORD=postgres
